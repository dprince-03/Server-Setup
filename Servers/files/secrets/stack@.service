# /etc/systemd/system/stack@.service: run /opt/stacks/<name>/compose.yaml with secrets injected at runtime.
#   sudo systemctl enable --now stack@myapp      (re)deploy: sudo systemctl restart stack@myapp
# Requires:
#   /etc/credstore.encrypted/bws-token     created with systemd-creds (see Server-Setup/SECRETS.md). The human types the token
#   /opt/stacks/<name>/BWS_PROJECT_ID      non-secret project ID
#   /opt/stacks/<name>/RELEASE             optional, non-secret image tag (set by CI), defaults to "latest"
# Swap `bws run --project-id ...` for `infisical run --` or `op run --` if you use another secret manager.
[Unit]
Description=Compose stack %i (secrets from the secret manager)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/stacks/%i
LoadCredentialEncrypted=bws-token:/etc/credstore.encrypted/bws-token
ExecStart=/bin/sh -ec 'export IMAGE_TAG="$$(cat RELEASE 2>/dev/null || echo latest)"; \
  export BWS_ACCESS_TOKEN="$$(cat "$$CREDENTIALS_DIRECTORY/bws-token")"; \
  exec bws run --project-id "$$(cat BWS_PROJECT_ID)" -- docker compose up -d --remove-orphans --wait'
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
