# .kamal/secrets: contains NO secret values, only commands that fetch them from your secret manager at deploy time.
# Kamal 2 adapters: bitwarden, bitwarden-sm (Secrets Manager), 1password, lastpass, aws_secrets_manager, gcp_secret_manager, doppler.
# Check the adapter syntax for your Kamal version: `kamal secrets fetch --help`.
# Prerequisite: YOU are logged in to the secret manager CLI on the deploying machine (e.g. BWS_ACCESS_TOKEN typed at a hidden prompt).

SECRETS=$(kamal secrets fetch --adapter bitwarden-sm <project-id>/KAMAL_REGISTRY_PASSWORD <project-id>/DATABASE_URL <project-id>/APP_SECRET_KEY <project-id>/POSTGRES_PASSWORD)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
DATABASE_URL=$(kamal secrets extract DATABASE_URL $SECRETS)
APP_SECRET_KEY=$(kamal secrets extract APP_SECRET_KEY $SECRETS)
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
